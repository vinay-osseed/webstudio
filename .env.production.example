# Production-only environment for docker-compose.prod.yml.
# Copy to .env.production, chmod 600, and NEVER commit the real file.

# Public builder URL
ACME_EMAIL=admin@agnsbroadband.in

# Google OAuth. Create/rotate the secret before production.
# Authorized JavaScript origin:
#   https://webstudio.agnsbroadband.in
# Authorized redirect URI:
#   https://webstudio.agnsbroadband.in/auth/google/callback
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# Generated locally/on the VPS by scripts/prod/generate-env.sh
POSTGRES_PASSWORD=CHANGE_ME
PGRST_JWT_SECRET=CHANGE_ME
AUTH_SECRET=CHANGE_ME
AUTH_WS_CLIENT_ID=agns-webstudio-cli
AUTH_WS_CLIENT_SECRET=CHANGE_ME
MINIO_ROOT_USER=webstudio
MINIO_ROOT_PASSWORD=CHANGE_ME

# Builder behavior
FEATURES=*
USER_PLAN=Pro
MAX_ASSETS_PER_PROJECT=250
S3_REGION=us-east-1
S3_BUCKET=webstudio-assets

# Images. scripts/prod/pin-images.sh converts mutable tags to immutable digests.
BUILDER_IMAGE=ghcr.io/webstudio-community/builder:latest
POSTGRES_IMAGE=postgres:15.19-alpine
POSTGREST_IMAGE=postgrest/postgrest:v12.2.0
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
CADDY_IMAGE=caddy:2.10.2-alpine
NGINX_IMAGE=nginx:1.29-alpine
ALPINE_IMAGE=alpine:3.22

# Self-hosted publisher and CLI export
PUBLISHER_IMAGE=ghcr.io/webstudio-community/webstudio-publisher:latest
TRPC_SERVER_API_TOKEN=change-me
PUBLISHER_HOST=webstudio.agnsbroadband.in
WEBSTUDIO_CLI_VERSION=0.290.0
